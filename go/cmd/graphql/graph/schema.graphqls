scalar Time

type User {
  id: ID!
  email: String!
  role: String!
  tenantId: ID!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresAt: Time!
  user: User!
}

type ProposedTransaction {
  id: ID!
  realmId: String!
  sourceType: String!
  rawAmount: Float!
  rawDate: Time
  rawDescription: String
  predictedVendorId: String
  predictedAccountId: String
  confidenceScore: Float!
  aiReasoning: String
}

input RecordCorrectionInput {
  realmId: String!
  rawInput: String!
  aiPrediction: String
  userCorrection: String!
  correctionType: String!
  confidenceScore: Float
}

type QBOCompany {
  realmId: ID!
  companyName: String!
  connectedAt: Time
}

input SignupInput {
  email: String!
  password: String!
  orgName: String!
}

input LoginInput {
  email: String!
  password: String!
}

input CreateQboAccountInput {
  realmId: ID!
  name: String!
  accountType: String!
  accountSubType: String
  classification: String
  description: String
  active: Boolean
  subAccount: Boolean
  parentRefValue: String
  currencyRefValue: String
}

input UpdateQboAccountInput {
  realmId: ID!
  accountId: ID!
  name: String
  accountType: String
  accountSubType: String
  description: String
  active: Boolean
}

input SoftDeleteQboAccountInput {
  realmId: ID!
  accountId: ID!
}

type Mutation {
  signup(input: SignupInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  requestOTP(email: String!): Boolean!
  verifyOTP(email: String!, otp: String!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  deleteToken(refreshToken: String!): Boolean!
  recordCorrection(input: RecordCorrectionInput!): Boolean!
  syncQboChartOfAccounts(realmId: ID!): Int!
  syncQboCustomers(realmId: ID!): Int!
  
  createQboAccount(input: CreateQboAccountInput!): Account!
  updateQboAccount(input: UpdateQboAccountInput!): Account!
  softDeleteQboAccount(input: SoftDeleteQboAccountInput!): Account!
}

type AccountMatch {
  accountId: ID!
  score: Float!
  name: String!
}

type EntityMatch {
  id: ID!
  score: Float!
  name: String!
  source: String!
  entityType: String!
}

type Tenant {
  id: ID!
  name: String!
  status: String!
  planTier: String!
  createdAt: Time!
  updatedAt: Time!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

type TenantConnection {
  nodes: [Tenant!]!
  totalCount: Int!
  pageInfo: PageInfo!
}

type Vendor {
  id: ID!
  realmId: String!
  qboId: String!
  displayName: String!
  syncToken: String!
  lastKnownAccountId: String
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Query {
  user: User
  qboConnection: QBOCompany
  suggestAccounts(description: String!): [AccountMatch!]!
  resolveEntity(entityType: String!, name: String!): EntityMatch
  qbo_account(realmId: ID!): [Account!]!
  qboCustomers(realmId: ID!): [Customer!]!
  qboCustomersByTenant(tenantId: ID!, includeChildren: Boolean = false): [Customer!]!
  # Protected: Requires authentication token
  tenants(limit: Int!, offset: Int!): TenantConnection!
  # Vendors: by realm, by single entity, or by tenant tree (including children)
  qboVendors(realmId: ID!): [Vendor!]!
  qboVendorsByEntity(entityId: ID!): [Vendor!]!
  qboVendorsByTenant(tenantId: ID!): [Vendor!]!
}

type Customer {
  id: ID!
  realmId: String!
  displayName: String!
  syncToken: String!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Account {
  id: ID!
  realmId: String!
  name: String!
  classification: String
  accountType: String
  accountSubType: String
  fullyQualifiedName: String
  active: Boolean
  syncToken: String!
  domain: String
  currencyRefName: String
  currencyRefValue: String
  currentBalanceWithSubAccounts: Float
  sparse: Boolean
  qboCreatedTime: Time
  qboUpdatedTime: Time
  currentBalance: Float
  subAccount: Boolean
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}
