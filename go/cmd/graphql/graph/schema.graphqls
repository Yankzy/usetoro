scalar Time
scalar Upload

type FileIngestionResponse {
  uploadId: ID!
  status: String!
  topic: String!
}

type User {
  id: ID!
  email: String!
  role: String!
  tenantId: ID!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresAt: Time!
  user: User!
}



input RecordCorrectionInput {
  realmId: String!
  rawInput: String!
  aiPrediction: String
  userCorrection: String!
  correctionType: String!
  confidenceScore: Float
}

type QBOCompany {
  realmId: ID!
  companyName: String!
  connectedAt: Time
}

input SignupInput {
  email: String!
  password: String!
  orgName: String!
}

input LoginInput {
  email: String!
  password: String!
}

input CreateQboAccountInput {
  realmId: ID!
  name: String!
  accountType: String!
  accountSubType: String
  classification: String
  description: String
  active: Boolean
  subAccount: Boolean
  parentRefValue: String
  currencyRefValue: String
}

input UpdateQboAccountInput {
  realmId: ID!
  accountId: ID!
  name: String
  accountType: String
  accountSubType: String
  description: String
  active: Boolean
}

input UpdateQboCompanyInput {
  realmId: ID!
  companyName: String
  legalName: String
  domain: String
  country: String
}


input SoftDeleteQboAccountInput {
  realmId: ID!
  accountId: ID!
}

type Mutation {
  signup(input: SignupInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  requestOTP(email: String!): Boolean!
  verifyOTP(email: String!, otp: String!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  deleteToken(refreshToken: String!): Boolean!
  recordCorrection(input: RecordCorrectionInput!): Boolean!
  syncQboChartOfAccounts(realmId: ID!): Int!
  syncQboCustomers(realmId: ID!): Int!

  createQboAccount(input: CreateQboAccountInput!): Account!
  updateQboAccount(input: UpdateQboAccountInput!): Account!
  softDeleteQboAccount(input: SoftDeleteQboAccountInput!): Account!

  updateQboCompanyInfo(input: UpdateQboCompanyInput!): QBOCompany!

  # Fignode & Clean-Up Mode mutations
  fignodeCategorize(rowId: ID!, accountId: ID, vendorId: ID, action: String!): FignodeStagingRow!
  approveAllByVendor(sessionId: ID!, vendorId: ID!): Int!
  postFignodeSession(sessionId: ID!): FignodePostResult!
  ingestFile(domain: String!, taskType: String!, file: Upload!, outflowIs: String, bankAccountName: String): FileIngestionResponse!
}

# ─── Fignode & Clean-Up Mode Types ───────────────────────────────────────────

type FignodeSession {
  id: ID!
  realmId: String     # null when QBO is not connected (Excel-only mode)
  fileName: String
  rowCount: Int!
  isAmbiguous: Boolean!
  ambiguityReason: String
  status: String!
  createdAt: Time!
  updatedAt: Time!
}

type FignodeStagingRow {
  id: ID!
  sessionId: String
  realmId: String
  sourceType: String!
  rawDescription: String
  rawAmount: Float!
  rawDate: Time
  rawVendorName: String
  # AI predictions
  predictedVendorId: String
  predictedVendorName: String
  predictedAccountId: String
  predictedAccountName: String
  predictedAccountType: String
  normalizedVendor: String
  confidenceScore: Float
  aiReasoning: String
  # Smart discovery
  isDuplicate: Boolean!
  duplicateOf: String
  isRecurring: Boolean!
  splitSuggestion: String
  # CPA overrides
  overrideVendorId: String
  overrideVendorName: String
  overrideAccountId: String
  overrideAccountName: String
  # Counterparty context
  paidWith: String
  paidInto: String
  # Lifecycle
  status: String!
  erpTransactionId: String
  createdAt: Time!
  updatedAt: Time!
}

type FignodePostResult {
  sessionId: ID!
  postedCount: Int!
  errorCount: Int!
  errors: [String!]!
}

type AccountMatch {
  accountId: ID!
  score: Float!
  name: String!
}

type EntityMatch {
  id: ID!
  score: Float!
  name: String!
  source: String!
  entityType: String!
}

type Tenant {
  id: ID!
  name: String!
  status: String!
  planTier: String!
  createdAt: Time!
  updatedAt: Time!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

type FignodeStagingRowEdge {
  cursor: String!
  node: FignodeStagingRow!
}

type AccountNamesByType {
  accountType: String!
  names: [String!]!
}

type FignodeStagingRowConnection {
  edges: [FignodeStagingRowEdge!]!
  nodes: [FignodeStagingRow!]!
  pageInfo: PageInfo!
  totalCount: Int!
  accountNamesByType: [AccountNamesByType!]!
}

type TenantConnection {
  nodes: [Tenant!]!
  totalCount: Int!
  pageInfo: PageInfo!
}

type Vendor {
  id: ID!
  realmId: String!
  erpId: String!
  displayName: String!
  syncToken: String!
  lastKnownAccountId: String
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Query {
  user: User
  qboConnection: QBOCompany
  suggestAccounts(description: String!): [AccountMatch!]!
  resolveEntity(entityType: String!, name: String!): EntityMatch
  qbo_account(realmId: ID!): [Account!]!
  qboCustomers(realmId: ID!): [Customer!]!
  qboCustomersByTenant(tenantId: ID!, includeChildren: Boolean = false): [Customer!]!
  # Protected: Requires authentication token
  tenants(limit: Int!, offset: Int!): TenantConnection!
  # Vendors: by realm, by single entity, or by tenant tree (including children)
  qboVendors(realmId: ID!): [Vendor!]!
  qboVendorsByEntity(entityId: ID!): [Vendor!]!
  qboVendorsByTenant(tenantId: ID!): [Vendor!]!
  # Fignode Staging & Clean-Up Mode
  # realmId is optional — omit for sessions without a QBO connection.
  fignodeSessions(realmId: ID): [FignodeSession!]!
  fignodeSession(sessionId: ID!): FignodeSession!
  fignodeBatch(sessionId: ID, limit: Int!): [FignodeStagingRow!]!
  stagingRows(sessionId: ID!, status: String): [FignodeStagingRow!]!
  stagingRowsConnection(
    sessionId: ID!
    status: String
    first: Int
    after: String
  ): FignodeStagingRowConnection!
  
  # Transaction Data Pull
  transactions(realmId: ID!, status: String): [Transaction!]!
  
  # Entity Data Pull
  accounts(realmId: ID!, type: String, active: Boolean): [Account!]!
  vendors(realmId: ID!, search: String): [Vendor!]!
  customers(realmId: ID!, search: String): [Customer!]!
}

type Customer {
  id: ID!
  realmId: String!
  displayName: String!
  syncToken: String!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Account {
  id: ID!
  realmId: String!
  name: String!
  classification: String
  accountType: String
  accountSubType: String
  fullyQualifiedName: String
  active: Boolean
  syncToken: String!
  domain: String
  currencyRefName: String
  currencyRefValue: String
  currentBalanceWithSubAccounts: Float
  sparse: Boolean
  erpCreatedTime: Time
  erpUpdatedTime: Time
  currentBalance: Float
  subAccount: Boolean
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type Transaction {
  id: ID!
  externalId: String!
  amount: Float!
  vendorName: String
  vendorId: String
  accountId: String
  date: Time!
  description: String
  memo: String
  sourceType: String!
}
