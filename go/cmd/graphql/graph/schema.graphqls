scalar Time

type User {
  id: ID!
  email: String!
  role: String!
  tenantId: ID!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresAt: Time!
  user: User!
}

type ProposedTransaction {
  id: ID!
  realmId: String!
  sourceType: String!
  rawAmount: Float!
  rawDate: Time
  rawDescription: String
  predictedVendorId: String
  predictedAccountId: String
  confidenceScore: Float!
  aiReasoning: String
}

input RecordCorrectionInput {
  realmId: String!
  rawInput: String!
  aiPrediction: String
  userCorrection: String!
  correctionType: String!
  confidenceScore: Float
}

type QBOCompany {
  realmId: ID!
  companyName: String!
  connectedAt: Time
}

input SignupInput {
  email: String!
  password: String!
  orgName: String!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  signup(input: SignupInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  requestOTP(email: String!): Boolean!
  verifyOTP(email: String!, otp: String!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  deleteToken(refreshToken: String!): Boolean!
  recordCorrection(input: RecordCorrectionInput!): Boolean!
}

type AccountMatch {
  accountId: ID!
  score: Float!
  name: String!
}

type EntityMatch {
  id: ID!
  score: Float!
  name: String!
  source: String!
  entityType: String!
}

type Tenant {
  id: ID!
  name: String!
  status: String!
  planTier: String!
  createdAt: Time!
  updatedAt: Time!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

type TenantConnection {
  nodes: [Tenant!]!
  totalCount: Int!
  pageInfo: PageInfo!
}

type Query {
  user: User
  qboConnection: QBOCompany
  suggestAccounts(description: String!): [AccountMatch!]!
  resolveEntity(entityType: String!, name: String!): EntityMatch
  qbo_account(realmId: ID!): [Account!]!
  # Protected: Requires authentication token
  tenants(limit: Int!, offset: Int!): TenantConnection!
}

type Account {
  id: ID!
  realmId: String!
  name: String!
  classification: String
  accountType: String
  accountSubType: String
  fullyQualifiedName: String
  active: Boolean
  syncToken: String!
  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}
