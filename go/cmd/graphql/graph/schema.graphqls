scalar Time

type User {
  id: ID!
  email: String!
  role: String!
  tenantId: ID!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresAt: Time!
  user: User!
}

type ProposedTransaction {
  id: ID!
  realmId: String!
  sourceType: String!
  rawAmount: Float!
  rawDate: Time
  rawDescription: String
  predictedVendorId: String
  predictedAccountId: String
  confidenceScore: Float!
  aiReasoning: String
}

input RecordCorrectionInput {
  realmId: String!
  rawInput: String!
  aiPrediction: String
  userCorrection: String!
  correctionType: String!
  confidenceScore: Float
}

type QBOCompany {
  realmId: ID!
  companyName: String!
  connectedAt: Time
}

input SignupInput {
  email: String!
  password: String!
  orgName: String!
}

input LoginInput {
  email: String!
  password: String!
}

type Mutation {
  signup(input: SignupInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  requestOTP(email: String!): Boolean!
  verifyOTP(email: String!, otp: String!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  deleteToken(refreshToken: String!): Boolean!
  recordCorrection(input: RecordCorrectionInput!): Boolean!
}

type AccountMatch {
  accountId: ID!
  score: Float!
  name: String!
}

type EntityMatch {
  id: ID!
  score: Float!
  name: String!
  source: String!
  entityType: String!
}

type Query {
  user: User
  qboConnection: QBOCompany
  suggestAccounts(description: String!): [AccountMatch!]!
  resolveEntity(entityType: String!, name: String!): EntityMatch
}
