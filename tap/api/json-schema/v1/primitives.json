{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Economic Primitives",
    "definitions": {
        "task": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "domain": {
                    "type": "string"
                },
                "complexity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                },
                "reward": {
                    "type": "integer"
                },
                "currency": {
                    "type": "string"
                },
                "payload": {
                    "type": "object"
                },
                "expires_at": {
                    "type": "integer"
                }
            },
            "required": [
                "id",
                "domain",
                "complexity",
                "reward",
                "currency",
                "payload",
                "expires_at"
            ]
        },
        "contract": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "cid": {
                    "type": "string"
                },
                "initiator_did": {
                    "type": "string"
                },
                "acceptor_did": {
                    "type": "string"
                },
                "terms": {
                    "type": "object"
                },
                "terms_hash": {
                    "type": "string"
                },
                "signatures": {
                    "type": "object"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "DRAFT",
                        "LOCKED",
                        "SETTLED",
                        "DISPUTED"
                    ]
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "id",
                "cid",
                "initiator_did",
                "acceptor_did",
                "terms",
                "terms_hash",
                "signatures",
                "status",
                "created_at"
            ]
        },
        "proof": {
            "type": "object",
            "properties": {
                "task_id": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "ts": {
                    "type": "integer"
                },
                "data": {
                    "type": "object"
                },
                "sig": {
                    "type": "string"
                }
            },
            "required": [
                "task_id",
                "type",
                "ts",
                "data",
                "sig"
            ]
        }
    }
}